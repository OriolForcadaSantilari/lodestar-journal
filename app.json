{
  "expo": {
    "name": "Lodestar",
    "slug": "lodestar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060d09"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oriolforcada.lodestar",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060d09"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.oriolforcada.lodestar"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c82d45ca-c6e7-4ff9-b51e-52212f487c1b"
      }
    }
  }
}
